# EmailJS — copy this file to .env.local and fill in values from
# https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Contact email shown on the site and used as the mailto fallback
VITE_CONTACT_EMAIL=email@example.com
